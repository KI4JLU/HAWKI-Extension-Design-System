{
	"name": "hawki-extension-design-system",
	"version": "0.0.1",
	"description": "Provisional name — see README. Component library for HAWKI extensions, built with Svelte 5.",
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"main": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"scripts": {
		"build": "svelte-package",
		"prepare": "npm run build",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"lint": "eslint . && prettier --check .",
		"test": "vitest run",
		"storybook": "echo \"storybook is not set up yet — see card 07\" && exit 1",
		"build-storybook": "echo \"storybook is not set up yet — see card 07\" && exit 1"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@internationalized/date": "^3.8.1",
		"bits-ui": "^2.19.0",
		"class-variance-authority": "^0.7.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@testing-library/svelte": "^5.4.2",
		"eslint": "^10.9.1",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"jsdom": "^30.0.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	}
}
