{
	"name": "hawki-extension-design-system",
	"version": "0.0.1",
	"description": "Provisional name — see README. Component library for HAWKI extensions, built with Svelte 5.",
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"main": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./styles/full.css": "./dist/styles/full.css",
		"./styles/tokens.css": "./dist/styles/tokens.css"
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"scripts": {
		"build": "svelte-package && node scripts/clean-dist-stories.mjs",
		"prepare": "npm run build",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:story-coverage": "node scripts/check-story-coverage.mjs",
		"format": "prettier --write .",
		"lint": "eslint . && prettier --check .",
		"test": "vitest run",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@internationalized/date": "^3.8.1",
		"bits-ui": "^2.19.0",
		"class-variance-authority": "^0.7.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@storybook/addon-a11y": "^10.5.10",
		"@storybook/addon-docs": "^10.5.10",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-vitest": "^10.5.10",
		"@storybook/svelte": "^10.5.10",
		"@storybook/svelte-vite": "^10.5.10",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.3.0",
		"@vitest/browser": "^4.1.11",
		"@vitest/browser-playwright": "^4.1.11",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.9.1",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"jsdom": "^30.0.1",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"storybook": "^10.5.10",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	}
}
